# Postgres. The app runs on the HOST, outside Docker, so it connects via localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hdfc_rm
# Used ONLY by the seed script, to drop/create the hdfc_rm database itself.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Ollama — used for entity extraction and draft composition, always.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Hard request timeout so a wedged model slot can't hang a graph run forever.
OLLAMA_TIMEOUT_S=60

# Which provider classifies intent: "ollama" or "anthropic".
# Only the Intent Classifier agent uses this; everything else stays on Ollama.
INTENT_PROVIDER=ollama

# Anthropic — ONLY needed if you set INTENT_PROVIDER=anthropic above.
# Leave blank to run fully locally. This file is .env, which is gitignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Cost/latency lever: low | medium | high | xhigh | max.
# Classifying a short email against a two-value taxonomy does not need deep reasoning.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=1024

# RM persona used for the draft sign-off
RM_NAME=Priya Nair
RM_TITLE=Relationship Manager
RM_BANK=HDFC Bank
